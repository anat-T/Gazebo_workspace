# External ROS2 packages this workspace depends on but doesn't vendor -
# fetch with: vcs import src < dependencies.repos
#
# Gripper: OnRobot 2FG7 (real hardware only - not used in any Gazebo
# scene, which use the DetachableJoint plugin instead; see
# box_pick_place_demo/real_grasp_controller.py).
repositories:
  onrobot_2fg7_interfaces:
    type: git
    url: https://github.com/davedovrat/onrobot_2fg7_interfaces.git
    version: 070595b60f851a5208e36e3889392c116824187a  # main as of 2026-11-19, the version this was tested with
  onrobot_2fg7:
    type: git
    url: https://github.com/davedovrat/onrobot_2fg7.git
    version: 1515b345fa4794a5b5414f5ab998907856d888c0  # main as of 2026-11-19, the version this was tested with

