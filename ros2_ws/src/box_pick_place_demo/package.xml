<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>box_pick_place_demo</name>
  <version>0.0.1</version>
  <description>
    Two-robot box pick demo in Gazebo: one robot gets a wide belief region
    for the box and guesses once (usually missing), the other gets a
    narrower region ("help") and guesses once (reliably landing on the
    box). Optionally reuses the camera and SE_server infrastructure to
    confirm a successful grasp.
  </description>
  <maintainer email="anat19960@gmail.com">anat</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <!-- Real-hardware only (real_ball_sort_node.py / real_grasp_controller.py):
       onrobot_2fg7/onrobot_2fg7_interfaces are fetched via
       ros2_ws/dependencies.repos, not vendored; ur_robot_driver is a
       normal apt/rosdep dependency (ros-humble-ur-robot-driver). -->
  <exec_depend>onrobot_2fg7</exec_depend>
  <exec_depend>onrobot_2fg7_interfaces</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
